# Backend configuration for Docker Compose (service hostnames, not localhost).
# Used via `env_file` by the api and worker containers (and postgres for its credentials).
# For running the API directly on your machine use Backend/.env (see .env.example) instead.

NODE_ENV=production
PORT=5000
API_PREFIX=api/v1
TZ=Asia/Kolkata
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
FRONTEND_URL=http://localhost:8080
ALLOW_PUBLIC_REGISTRATION=true
# Demo mode: one-click demo logins on the sign-in page + rich demo data (turn OFF in production)
DEMO_MODE=true
SEED_DEMO_DATA=true
THROTTLE_LIMIT=1500

# PostgreSQL (container credentials + connection string must match)
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_password
POSTGRES_DB=pos
DATABASE_URL=postgresql://pos:pos_password@postgres:5432/pos?schema=public

REDIS_URL=redis://redis:6379

KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=ws-pos
KAFKA_TOPIC_PREFIX=pos

OPENSEARCH_ENABLED=true
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=pos

# CHANGE THESE (min 16 chars) for anything other than local use
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=10

# Applied by the api container on boot
RUN_MIGRATIONS=true
RUN_SEED=true
SEED_ADMIN_EMAIL=admin@harmonyhub.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_BRANCH_ID=b1c2d3e4-f5a6-7890-bcde-f12345678901
