# ───────── App ─────────
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
# all  = HTTP + Socket.IO + every Kafka consumer (simplest, local dev)
# api  = HTTP + Socket.IO + realtime consumer only
# worker = background consumers + BullMQ processors, no HTTP port
APP_ROLE=all
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# First registered user becomes SUPER_ADMIN. Set false to force admin-created staff only.
ALLOW_PUBLIC_REGISTRATION=true
# Demo mode: one-click demo logins on the sign-in page + rich demo data (turn OFF in production)
DEMO_MODE=true
SEED_DEMO_DATA=true

# ───────── PostgreSQL / Prisma ─────────
# host port 5433 matches POSTGRES_PORT below (compose maps it to the container's 5432)
DATABASE_URL=postgresql://pos:pos_password@localhost:5433/pos?schema=public

# ───────── Redis (cache, BullMQ, Socket.IO adapter) ─────────
REDIS_URL=redis://localhost:6379

# ───────── Kafka (event streaming + message broker) ─────────
# Set KAFKA_ENABLED=false to run events in-process (no broker needed in dev)
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=ws-pos
KAFKA_TOPIC_PREFIX=pos

# ───────── OpenSearch ─────────
OPENSEARCH_ENABLED=true
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=pos

# ───────── Auth ─────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=10

# ───────── Seed ─────────
SEED_ADMIN_EMAIL=admin@harmonyhub.com
SEED_ADMIN_PASSWORD=Admin@12345
# Same id the frontend uses in NEXT_PUBLIC_BRANCH_ID
SEED_BRANCH_ID=b1c2d3e4-f5a6-7890-bcde-f12345678901

# ───────── Misc ─────────
FRONTEND_URL=http://localhost:8080
THROTTLE_LIMIT=1500

# ───────── Docker Compose only (host port mappings / DB credentials) ─────────
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_password
POSTGRES_DB=pos
POSTGRES_PORT=5433   # host port; 5433 avoids clashing with a local PostgreSQL on 5432
REDIS_PORT=6379
KAFKA_EXTERNAL_PORT=29092
OPENSEARCH_PORT=9200
API_PORT=5000
TZ=Asia/Kolkata
RUN_SEED=true
