// Harmony Hub POS - database schema
// Enum values intentionally mirror the strings used by the Next.js frontend
// (e.g. 'dine_in', 'preparing', 'SUPER_ADMIN') so no mapping is needed over the wire.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum AppRole {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  BRANCH_MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
  CUSTOMER
}

enum TableStatus {
  available
  occupied
  reserved
  cleaning
}

enum OrderStatus {
  pending
  preparing
  ready
  served
  cancelled
}

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum PaymentMethod {
  cash
  card
  upi
  wallet
  mixed
}

enum PaymentStatus {
  pending
  partial
  completed
  refunded
}

enum KotStatus {
  printed
  acknowledged
  completed
  cancelled
}

enum ReservationStatus {
  pending
  confirmed
  seated
  completed
  cancelled
  no_show
}

enum InventoryTxType {
  purchase
  usage
  adjustment
  wastage
}

enum PrintJobStatus {
  pending
  printing
  completed
  failed
  delegated
}

// ───────────────────────── Tenancy ─────────────────────────

model Restaurant {
  id            String   @id @default(uuid())
  name          String
  logo          String?
  address       String?
  phone         String?
  email         String?
  currency      String   @default("INR")
  taxRate       Decimal  @default(5) @db.Decimal(5, 2) // percent
  serviceCharge Decimal  @default(5) @db.Decimal(5, 2) // percent
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches Branch[]
  roles    UserRole[]

  @@map("restaurants")
}

model Branch {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  address      String?
  phone        String?
  openingTime  String   @default("09:00")
  closingTime  String   @default("23:00")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables            RestaurantTable[]
  categories        Category[]
  menuItems         MenuItem[]
  orders            Order[]
  kots              Kot[]
  inventory         InventoryItem[]
  reservations      Reservation[]
  printers          Printer[]
  printJobs         PrintJob[]
  printTemplates    PrintTemplate[]
  notifications     Notification[]
  roles             UserRole[]
  bills             Bill[]

  @@index([restaurantId])
  @@map("branches")
}

// ───────────────────────── Auth ─────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles         UserRole[]
  refreshTokens RefreshToken[]
  ordersServed  Order[]        @relation("OrderWaiter")
  payments      Payment[]
  notifications Notification[]

  @@map("users")
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  role         AppRole
  restaurantId String?
  branchId     String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, role, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────────────────── Floor ─────────────────────────

model RestaurantTable {
  id             String      @id @default(uuid())
  branchId       String
  tableNumber    String
  capacity       Int         @default(4)
  floor          String      @default("Ground")
  area           String      @default("Main Hall")
  status         TableStatus @default(available)
  qrCode         String?
  currentOrderId String?
  mergedIntoId   String? // set on secondary tables of a merged group
  positionX      Float?
  positionY      Float?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  mergedInto   RestaurantTable?  @relation("TableMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedTables RestaurantTable[] @relation("TableMerge")
  orders       Order[]
  reservations Reservation[]

  @@unique([branchId, tableNumber])
  @@index([branchId, status])
  @@map("restaurant_tables")
}

// ───────────────────────── Menu ─────────────────────────

model Category {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  description String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([branchId, name])
  @@index([branchId, sortOrder])
  @@map("categories")
}

model MenuItem {
  id              String   @id @default(uuid())
  branchId        String
  categoryId      String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  image           String?
  isVeg           Boolean  @default(true)
  isAvailable     Boolean  @default(true)
  preparationTime Int      @default(10) // minutes
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    MenuVariant[]
  addons      MenuAddon[]
  ingredients RecipeIngredient[]
  orderItems  OrderItem[]

  @@index([branchId, categoryId])
  @@index([branchId, isAvailable])
  @@map("menu_items")
}

model MenuVariant {
  id            String   @id @default(uuid())
  menuItemId    String
  name          String
  priceModifier Decimal  @default(0) @db.Decimal(10, 2)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_variants")
}

model MenuAddon {
  id         String  @id @default(uuid())
  menuItemId String
  name       String
  price      Decimal @default(0) @db.Decimal(10, 2)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_addons")
}

// ───────────────────────── Orders ─────────────────────────

model Order {
  id                String      @id @default(uuid())
  branchId          String
  tableId           String?
  waiterId          String?
  customerSessionId String?
  customerName      String?
  customerPhone     String?
  orderNumber       String
  orderType         OrderType   @default(dine_in)
  status            OrderStatus @default(pending)
  subtotal          Decimal     @default(0) @db.Decimal(12, 2)
  tax               Decimal     @default(0) @db.Decimal(12, 2)
  serviceCharge     Decimal     @default(0) @db.Decimal(12, 2)
  discount          Decimal     @default(0) @db.Decimal(12, 2)
  total             Decimal     @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  servedAt          DateTime?
  paidAt            DateTime?

  branch    Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table     RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  waiter    User?            @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  kots      Kot[]
  bills     Bill[]
  billLinks BillOrder[]

  @@unique([branchId, orderNumber])
  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([tableId])
  @@index([waiterId])
  @@map("orders")
}

model OrderItem {
  id          String      @id @default(uuid())
  orderId     String
  menuItemId  String
  name        String // snapshot of menu item name
  quantity    Int
  unitPrice   Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(12, 2)
  status      OrderStatus @default(pending)
  notes       String?
  variantName String?
  addons      Json?
  course      String?
  kotPrinted  Boolean     @default(false)
  kotId       String?
  billedByBillId String? // set when this line was settled by a partial bill
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  kot      Kot?     @relation(fields: [kotId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([menuItemId])
  @@index([kotId])
  @@map("order_items")
}

model Kot {
  id          String    @id @default(uuid())
  branchId    String
  orderId     String
  kotNumber   String
  status      KotStatus @default(printed)
  isReprint   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@unique([branchId, kotNumber])
  @@index([branchId, status])
  @@index([orderId])
  @@map("kots")
}

// ───────────────────────── Billing ─────────────────────────

model Bill {
  id            String        @id @default(uuid())
  branchId      String
  orderId       String // primary order (first order for merged bills)
  billNumber    String
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2)
  serviceCharge Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  kind          String        @default("full") // full | partial | merged | split
  notes         String?
  generatedAt   DateTime      @default(now())
  paidAt        DateTime?
  generatedById String?

  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]
  orders   BillOrder[]

  @@unique([branchId, billNumber])
  @@index([branchId, generatedAt])
  @@index([orderId])
  @@index([status])
  @@map("bills")
}

model BillOrder {
  billId  String
  orderId String

  bill  Bill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([billId, orderId])
  @@map("bill_orders")
}

model Payment {
  id           String        @id @default(uuid())
  billId       String
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  reference    String?
  receivedById String?
  createdAt    DateTime      @default(now())

  bill       Bill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  receivedBy User? @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([createdAt])
  @@map("payments")
}

// ───────────────────────── Inventory ─────────────────────────

model InventoryItem {
  id              String    @id @default(uuid())
  branchId        String
  name            String
  category        String    @default("General")
  unit            String    @default("kg")
  currentStock    Decimal   @default(0) @db.Decimal(12, 3)
  minStockLevel   Decimal   @default(0) @db.Decimal(12, 3)
  maxStockLevel   Decimal?  @db.Decimal(12, 3)
  costPerUnit     Decimal   @default(0) @db.Decimal(10, 2)
  lastRestockedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]
  recipes      RecipeIngredient[]

  @@unique([branchId, name])
  @@index([branchId, category])
  @@map("inventory")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  inventoryId     String
  transactionType InventoryTxType
  quantity        Decimal         @db.Decimal(12, 3) // always positive magnitude, except adjustment (signed)
  stockAfter      Decimal?        @db.Decimal(12, 3)
  notes           String?
  referenceId     String? // e.g. orderId for automatic usage
  createdById     String?
  createdAt       DateTime        @default(now())

  inventory InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, transactionType, referenceId])
  @@index([inventoryId, createdAt])
  @@map("inventory_transactions")
}

model RecipeIngredient {
  id          String  @id @default(uuid())
  menuItemId  String
  inventoryId String
  quantity    Decimal @db.Decimal(12, 3) // units of inventory per 1 menu item

  menuItem  MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventory InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryId])
  @@map("recipe_ingredients")
}

// ───────────────────────── Reservations ─────────────────────────

model Reservation {
  id              String            @id @default(uuid())
  branchId        String
  tableId         String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  partySize       Int
  reservationDate DateTime          @db.Date
  reservationTime String // HH:mm
  durationMinutes Int               @default(90)
  status          ReservationStatus @default(confirmed)
  specialRequests String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table  RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([branchId, reservationDate])
  @@index([tableId, reservationDate])
  @@map("reservations")
}

// ───────────────────────── Printing ─────────────────────────

model Printer {
  id             String   @id @default(uuid())
  branchId       String
  name           String
  type           String   @default("thermal") // thermal | receipt | kitchen
  connectionType String   @default("usb") // usb | network
  ipAddress      String?
  port           Int?     @default(9100)
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  categories     String[] @default([]) // category ids routed to this printer
  printFor       String[] @default([]) // kot | bill | report
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  jobs   PrintJob[]

  @@index([branchId])
  @@map("printers")
}

model PrintJob {
  id        String         @id @default(uuid())
  branchId  String
  printerId String?
  type      String // kot | bill | report | test | drawer
  status    PrintJobStatus @default(pending)
  payload   Json
  attempts  Int            @default(0)
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  printer Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)

  @@index([branchId, status])
  @@index([printerId])
  @@map("print_jobs")
}

model PrintTemplate {
  id        String   @id @default(uuid())
  branchId  String
  type      String // kot | bill
  name      String
  config    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, type, name])
  @@map("print_templates")
}

// ───────────────────────── Platform ─────────────────────────

model Notification {
  id        String    @id @default(uuid())
  branchId  String
  userId    String? // null = broadcast to branch
  type      String
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([branchId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  eventId    String   @unique
  type       String
  branchId   String?
  actorId    String?
  entityId   String?
  payload    Json
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([branchId, occurredAt])
  @@index([actorId])
  @@map("audit_logs")
}
